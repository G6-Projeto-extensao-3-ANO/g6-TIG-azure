    "type": "function",
    "z": "tab1",
    "name": "Acumula 15",
    "func": "const LIMITE = 15;\nconst buffer = context.get('buffer') || [];\nbuffer.push(msg);\n\nif (buffer.length < LIMITE) {\n    // Ainda nao chegou em 15: guarda e nao envia nada\n    context.set('buffer', buffer);\n    node.status({fill: 'yellow', shape: 'ring', text: buffer.length + '/' + LIMITE});\n    return null;\n}\n\n// Chegou em 15: limpa o buffer e envia as 15 mensagens de uma vez\ncontext.set('buffer', []);\nnode.status({fill: 'green', shape: 'dot', text: 'lote de ' + LIMITE + ' enviado'});\nreturn [buffer];",
